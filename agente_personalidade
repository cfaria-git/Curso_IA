from agno.agent import Agent
from agno.models.openai import OpenAIChat
from dotenv import load_dotenv

#Carregar a chave
load_dotenv()

#Criar o modelo do agent IA
agente = Agent (
    model=OpenAIChat(id="gpt-4o-mini"),
    description="Agente secreto do FBI que investiga informações cibernetica ao redor do mundo.",
    markdown=True
)

while True:
    pergunta = input("Digite a sua pergunta: ")
    
    if pergunta.lower() == "sair":
        print("Encerrando a sua pesquisa...")
        break
    else:
        agente.print_response(pergunta)